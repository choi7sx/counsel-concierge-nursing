# Leave blank during client review. Live activation is intentionally deferred.
# Set this only in CloudCannon after linking an Inbox and verifying its email target.
# Copy the exact linked Inbox key from Site Settings > Hosting > Forms.
# This is a public routing key, not an API key or email password.
# Leave blank locally. See README.md for activation and domain setup.
PUBLIC_CLOUDCANNON_INBOX_KEY=

# Optional search engine verification (see README.md, "Search engines and AI
# assistants"). Prefer DNS verification, which needs no code. If using the
# HTML-tag method instead, paste only the content value from the tag.
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=
