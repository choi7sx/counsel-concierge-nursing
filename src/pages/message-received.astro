---
import Counsel from '../layouts/Counsel.astro';
import InteriorPage from '../components/counsel/InteriorPage.astro';
import PageHero from '../components/counsel/PageHero.astro';
---
<Counsel title="Message received" noindex>
  <InteriorPage>
    <PageHero slot="hero" image="greeting" alt="Gus greeting a client at her front door">
      <Fragment slot="title">Thank you.</Fragment>
    </PageHero>
    <section class="wrap retainer-detail-copy" data-form-receipt>
      <h2>Your message has been received.</h2>
      <p class="lead">We review every submission personally and will follow up directly when a response is needed.</p>
      <a class="text-link" href="/">Return home →</a>
    </section>
  </InteriorPage>
</Counsel>
