---
import Counsel from "../layouts/Counsel.astro";
import InteriorPage from "../components/counsel/InteriorPage.astro";
import PageHero from "../components/counsel/PageHero.astro";
---
<Counsel title="Page not found">
  <InteriorPage>
    <PageHero slot="hero" image="greeting" alt="Gus greeting a client at her front door">
      <Fragment slot="title">Let’s find your way.</Fragment>
    </PageHero>
    <section class="wrap retainer-detail-copy">
      <p class="lead">The page you’re looking for may have moved. We’re here to help you take the next step.</p>
      <a class="text-link" href="/">Return home →</a>
    </section>
  </InteriorPage>
</Counsel>
