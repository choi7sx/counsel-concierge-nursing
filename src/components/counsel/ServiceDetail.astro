---
import type { Page } from "../../lib/counsel";
import { links, pageAt, retainerServices, serviceDetails, serviceHeroes, situationalServices } from "../../lib/counsel";
import InteriorPage from "./InteriorPage.astro";
import PageHero from "./PageHero.astro";
import Blocks from "./Blocks.astro";
import Arrow from "./Arrow.astro";
import ServiceCards from "./ServiceCards.astro";
const { page } = Astro.props as { page: Page };
const retainer = retainerServices.find((item) => item.path === page.path);
const situational = situationalServices.find((item) => item.path === page.path);
const service = (retainer || situational)!;
const hero = serviceHeroes[service.slug] || { image: "care", alt: "Gus discussing a care plan with clients at home" };
const detail = serviceDetails[service.slug];
const related = (retainer ? retainerServices : situationalServices).filter((item) => item.slug !== service.slug);
---

<InteriorPage>
<PageHero slot="hero" image={hero.image} alt={hero.alt}>
  <Fragment slot="title">{page.title}</Fragment>
</PageHero>
<section class="wrap retainer-detail-copy">
  <a class="text-link page-back-link" href={links.services}>← All services</a>
  <Blocks blocks={page.blocks} />
  {detail && <Blocks blocks={[detail]} headingLevel={2} />}
  <div class:list={["service-offerings", { "service-offerings-both": retainer && situational }]}>
    {retainer && (
      <div class="retainer-context">
        <h2>Monthly retainer</h2>
        <p>{pageAt(links.services).blocks[3].text!.split(". ")[0]}.</p>
        <a class="text-link" href={`${links.services}#monthly-retainer-services`}>Explore monthly retainer services <Arrow /></a>
      </div>
    )}
    {situational && (
      <div class="retainer-context">
        <h2>Situational service</h2>
        <p>{retainer ? situational.text.replace(situational.summary, "").trim() : "Available on its own, with no monthly retainer required."} Availability and pricing are determined on an individual basis following consultation.</p>
        <a class="text-link" href={`${links.services}#situational-services`}>Explore situational services <Arrow /></a>
      </div>
    )}
  </div>
  <a class="button" href={links.consultation}>Request Private Consultation <Arrow /></a>
</section>
<section class="section retainer-section">
  <div class="wrap">
    <div class="section-intro">
      {retainer ? <h2>Care that works <em>together.</em></h2> : <h2>More situational <em>services.</em></h2>}
    </div>
    <ServiceCards items={related} compact />
  </div>
</section>

</InteriorPage>
