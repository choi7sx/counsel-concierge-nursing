---
import CounselImage from "./CounselImage.astro";
import { articles, dateLabel } from "../../lib/counsel";
import type { Page } from "../../lib/counsel";
import InteriorPage from "./InteriorPage.astro";
import PageHero from "./PageHero.astro";
import Blocks from "./Blocks.astro";
import Arrow from "./Arrow.astro";
const { page } = Astro.props as { page: Page };
const article = articles.find((a) => a.path === page.path)!;
const related = articles.filter((a) => a.path !== page.path).slice(0, 2);
---

<InteriorPage>
<PageHero slot="hero" image={article.image} alt="">
  <a slot="before-title" class="text-link" href="/insights">← All Insights</a>
  <Fragment slot="title">{page.title}</Fragment>
</PageHero>
<article class="insight-article">
  <header class="article-header wrap">
    <div class="article-byline">
      <CounselImage src="/images/counsel/founder.webp" sizes="56px" width="56" height="56" alt="" />
      <div>
        <span>Written by {page.author || "Gus Osgood"}</span>
        <span>
          {dateLabel(page.date)} ·{" "}
          {Math.ceil((page.blocks[0].text?.split(/\s+/).length || 500) / 200)}{" "}
          min read
        </span>
      </div>
    </div>
    <p class="article-introduction">
      Perspective and guidance for adults and the families who care about them.
    </p>
  </header>
  <div class="article-layout wrap">
    <aside class="article-sidebar">
      <a class="text-link" href="/insights">
        Explore all insights <Arrow />
      </a>
    </aside>
    <div class="article-body">
      <Blocks blocks={page.blocks} headingLevel={2} />
      <div class="article-end">
        <span class="brand-name">counsel.</span>
        <p>
          Private nursing oversight.
          <br />
          Personal attention.
        </p>
      </div>
    </div>
  </div>
</article>
<section class="section related-section">
  <div class="wrap">
    <h2>More from our practice.</h2>
    <div class="related-grid">
      {related.map((a) => (
        <a href={a.path}>
          <h3>{a.title}</h3>
          <span class="text-link">
            Read insight <Arrow />
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

</InteriorPage>
