---
import CounselImage from "./CounselImage.astro";
import { articles, dateLabel } from "../../lib/counsel";
import Arrow from "./Arrow.astro";
const { limit = 4, images = true, headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 2 ? "h2" : "h3";
---

<div class:list={["insight-grid", { "insight-grid-full": limit === 4 }]}>
  {articles.slice(0, limit).map((article) => (
    <article class="insight-card">
      {images && (
        <a
          href={article.path}
          tabindex="-1"
          aria-hidden="true"
          class="insight-image"
        >
          <CounselImage
            src={article.image}
            sizes="(max-width: 760px) calc(100vw - 48px), (max-width: 1100px) 45vw, 400px"
            alt=""
            loading="lazy"
          />
        </a>
      )}
      <Heading>
        <a href={article.path}>{article.title}</a>
      </Heading>
      <div class="article-meta">
        <span>{article.category}</span>
        <span>{dateLabel(article.date)}</span>
      </div>
      <p>{article.excerpt}</p>
      <a class="text-link" href={article.path}>
        Read insight <Arrow />
      </a>
    </article>
  ))}
</div>
