---
import CounselImage from "./CounselImage.astro";
import { pageAt, links, retainerServices } from "../../lib/counsel";
import InteriorPage from "./InteriorPage.astro";
import PageHero from "./PageHero.astro";
import ServiceCards from "./ServiceCards.astro";
import Blocks from "./Blocks.astro";
import Arrow from "./Arrow.astro";
const b = pageAt(links.services).blocks;
---

<InteriorPage>
<PageHero slot="hero" image="greeting" alt="Gus greeting a client at her front door" position="center 30%">
  <Fragment slot="title">Private nursing,<br /><em>thoughtfully tailored.</em></Fragment>
</PageHero>
<section class="wrap services-overview services-overview-intro">
  <div class="services-intro"><Blocks blocks={[b[1]]} /></div>
</section>
<section class="section retainer-section" id="monthly-retainer-services">
  <div class="wrap">
    <div class="retainer-intro">
      <Blocks blocks={[b[2], b[3]]} />
    </div>
    <ServiceCards items={retainerServices} compact />
  </div>
</section>
<section class="section">
  <div class="wrap">
    <div class="section-intro">
      <Blocks blocks={[b[5]]} />
    </div>
    <div class="support-grid">
      {[6, 7, 8].map((n, i) => (
        <article class="support-item">
          <Blocks blocks={[b[n]]} />
          {n === 8 && (
            <a class="text-link" href={links.postop}>
              Explore post-operative care <Arrow />
            </a>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
<section class="scope-section section">
  <div class="wrap">
    <Blocks blocks={[b[9]]} />
    <div class="scope-grid">
      <div class="scope-card scope-card-is">
        <div class="scope-card-heading">
          <span class="scope-card-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 4.5 4.5L19 7" /></svg>
          </span>
          <Blocks blocks={[b[11]]} />
        </div>
        <Blocks blocks={[b[10]]} />
      </div>
      <div class="scope-card scope-card-is-not">
        <div class="scope-card-heading">
          <span class="scope-card-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="m6 6 12 12M18 6 6 18" /></svg>
          </span>
          <Blocks blocks={[b[13]]} />
        </div>
        <Blocks blocks={[b[12]]} />
      </div>
    </div>
  </div>
</section>
<section class="section services-start">
  <div class="wrap services-start-grid">
    <div class="services-start-copy">
      <Blocks blocks={[b[14]]} headingLevel={2} />
      <a class="button" href={links.consultation}>
        Request Private Consultation <Arrow />
      </a>
    </div>
    <CounselImage
      class="services-start-image"
      sizes="(max-width: 760px) calc(100vw - 48px), 568px"
      src="/images/counsel/care.webp"
      alt="Gus reviewing a care plan with a couple at their dining table"
      loading="lazy"
    />
  </div>
</section>
<section class="section">
  <div class="wrap split-section">
    <div class="section-sidebar">
      <Blocks blocks={[b[15]]} headingLevel={2} />
    </div>
    <Blocks blocks={[b[16]]} />
  </div>
</section>

</InteriorPage>
