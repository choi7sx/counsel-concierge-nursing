---
import Arrow from "./Arrow.astro";
interface Props {
  id: string;
  title: string;
  text: string;
  emailLabel: string;
  subject: string;
}
const { id, title, text, emailLabel, subject } = Astro.props;
---

<section class="consultation-inline direct-contact" aria-labelledby={id}>
  <h2 id={id}>{title}</h2>
  <p>{text}</p>
  <div class="direct-contact-actions">
    <a class="button" href={`mailto:info@counselconciergenursing.com?subject=${encodeURIComponent(subject)}`}>{emailLabel} <Arrow /></a>
    <a class="button button-outline" href="tel:+16159339208">Call (615) 933-9208</a>
  </div>
  <p class="consultation-hint">info@counselconciergenursing.com</p>
</section>
