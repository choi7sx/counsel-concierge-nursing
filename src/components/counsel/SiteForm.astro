---
import type { FormField, Page } from '../../lib/counsel';
interface Props {
  form: NonNullable<Page['form']>;
  id: string;
  subject: string;
  submitLabel: string;
  success: string;
}
const { form, id, subject, submitLabel, success } = Astro.props;
const inboxKey = import.meta.env.PUBLIC_CLOUDCANNON_INBOX_KEY?.trim() || '';
const deliveryReady = import.meta.env.PROD && Boolean(inboxKey);
const hasFile = form.fields.some((field) => field.type === 'file');
// CloudCannon Inboxes accept files up to 5MB.
const maxFileBytes = 5 * 1024 * 1024;

// Inbox submissions list fields by name, so other fields use their visible title.
const label = (field: FormField) => field.title.replace(/:\s*$/, '');
const fieldId = (field: FormField) => `${id}-${label(field).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`;
const full = (field: FormField) => ['name', 'textarea', 'file'].includes(field.type);
// Pair consecutive short fields into two-column rows, as in the consultation form.
const rows: FormField[][] = [];
for (const field of form.fields) {
  const last = rows.at(-1);
  if (!full(field) && last?.length === 1 && !full(last[0])) last.push(field);
  else rows.push([field]);
}
---
<form
  class="consultation-form site-form"
  data-site-form
  data-delivery-ready={String(deliveryReady)}
  data-success={success}
  method="post"
  action="/message-received/"
  enctype={hasFile ? 'multipart/form-data' : undefined}
>
  <input type="hidden" name="inbox_key" value={inboxKey} />
  <input type="hidden" name="_subject" value={subject} />
  <p class="consultation-required">All fields are required unless marked optional.</p>
  <fieldset class="consultation-fields">
    <legend class="visually-hidden">{form.name.trim()}</legend>
    {rows.map((row) => row[0].type === 'name' ? (
      <div class="consultation-field-row">
        <div class="consultation-field">
          <label for={`${id}-first-name`}>First name</label>
          <input id={`${id}-first-name`} name="firstName" autocomplete="given-name" required maxlength="80" data-trim />
        </div>
        <div class="consultation-field">
          <label for={`${id}-last-name`}>Last name</label>
          <input id={`${id}-last-name`} name="lastName" autocomplete="family-name" required maxlength="80" data-trim />
        </div>
      </div>
    ) : (
      <div class:list={{ 'consultation-field-row': row.length > 1 }}>
        {row.map((field) => (
          <div class="consultation-field">
            <label for={fieldId(field)}>{label(field)}{!field.required && <span> (optional)</span>}</label>
            {field.type === 'email' && <input id={fieldId(field)} name="_replyto" type="email" autocomplete="email" required={field.required} maxlength="254" />}
            {field.type === 'phone' && <input id={fieldId(field)} name="phone" type="tel" autocomplete="tel" required={field.required} maxlength="40" />}
            {field.type === 'text' && <input id={fieldId(field)} name={label(field)} required={field.required} maxlength="120" data-trim />}
            {field.type === 'select' && (
              <select id={fieldId(field)} name={label(field)} required={field.required}>
                <option value="" disabled selected>{field.placeholder || 'Select an option'}</option>
                {field.options!.map((option) => <option>{option}</option>)}
              </select>
            )}
            {field.type === 'textarea' && <textarea id={fieldId(field)} name={label(field)} rows="5" required={field.required} maxlength="4000" placeholder={field.placeholder || undefined} data-trim></textarea>}
            {field.type === 'file' && (
              <>
                <input id={fieldId(field)} name={label(field)} type="file" required={field.required} accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" data-max-bytes={maxFileBytes} aria-describedby={`${fieldId(field)}-hint`} />
                <p id={`${fieldId(field)}-hint`} class="consultation-hint">PDF or Word document, up to 5MB.</p>
              </>
            )}
          </div>
        ))}
      </div>
    ))}
    <div hidden aria-hidden="true">
      <label for={`${id}-website`}>Leave this field blank</label>
      <input id={`${id}-website`} name="_gotcha" tabindex="-1" autocomplete="off" />
    </div>
  </fieldset>
  <div class="consultation-status" data-form-status role="status" aria-live="polite" tabindex="-1" hidden></div>
  <div class="consultation-submit-row">
    <button class="button" type="submit" data-form-submit disabled={!deliveryReady}>{submitLabel} <span aria-hidden="true">→</span></button>
    <p class="consultation-privacy">Your details are used to respond to you. <a href="/privacy-policy" target="_blank" rel="noopener noreferrer">Privacy policy<span class="visually-hidden"> (opens in a new tab)</span></a></p>
  </div>
  {!deliveryReady && <noscript><p>Online forms are not available yet. Please call <a href="tel:+16159339208">(615) 933-9208</a> or email <a href="mailto:info@counselconciergenursing.com">info@counselconciergenursing.com</a>.</p></noscript>}
</form>
