---
import CounselImage from "./CounselImage.astro";
import Counsel from "../../layouts/Counsel.astro";
import { links, pageAt, retainerServices, approach } from "../../lib/counsel";
import Arrow from "./Arrow.astro";
import ServiceIcon from "./ServiceIcon.astro";
import InsightCards from "./InsightCards.astro";
const home = pageAt("/home");
const intro = home.blocks[2].text!;
const sentenceEnd = intro.search(/\.\s/);
const firstSentence = sentenceEnd < 0 ? intro : intro.slice(0, sentenceEnd + 1);
const remaining = sentenceEnd < 0 ? "" : intro.slice(sentenceEnd + 1).trim();
---

<Counsel>
  <section class="home-hero" aria-labelledby="home-heading">
    <CounselImage
      class="home-hero-photo"
      src="/images/counsel/consult.webp"
      alt="Gus Osgood meeting with an older adult and her family in their home"
      fetchpriority="high"
    />
    <div class="wrap home-hero-content">
      <div class="home-hero-copy">
        <h1 id="home-heading">
          <span>Independence, enhanced.</span>
          <em>Peace of mind, protected.</em>
        </h1>
        <p class="home-hero-description">{firstSentence}</p>
        <div class="home-hero-actions">
          <a class="button" href={links.consultation}>
            Request Private Consultation <Arrow />
          </a>
        </div>
      </div>
    </div>
  </section>
  <div class="trust-strip">
    <div class="wrap">
      <span>Registered nurse-led</span>
      <span>Private & personalized</span>
      <span>Proactive by design</span>
      <span>Nashville & Middle Tennessee</span>
    </div>
  </div>
  <section class="section clinical">
    <div class="wrap">
      <div class="section-heading clinical-heading">
        <div>
          <h2>
            The clinical layer
            <br />
            <em>of home care.</em>
          </h2>
        </div>
        <p>{remaining}</p>
      </div>
      <div class="pillars">
        {home.blocks[4].items!.map((item, i) => (
          <div class="pillar">
            <span class="line-icon" aria-hidden="true">
              {i === 0 ? (
                <svg viewBox="0 0 48 48">
                  <path d="M5 24h9l5-12 9 24 5-12h10" />
                  <circle cx="24" cy="24" r="21" />
                </svg>
              ) : i === 1 ? (
                <svg viewBox="0 0 48 48">
                  <path d="M24 3 7 10v13c0 10 17 21 17 21s17-11 17-21V10L24 3Z" />
                  <path d="m16 24 6 6 11-13" />
                </svg>
              ) : (
                <svg viewBox="0 0 48 48">
                  <path d="M24 40S5 29 5 16C5 5 19 3 24 13 29 3 43 5 43 16c0 13-19 24-19 24Z" />
                </svg>
              )}
            </span>
            <h3>{item.title}</h3>
            <div set:html={item.html} />
          </div>
        ))}
      </div>
    </div>
  </section>
  <div class="home-care-sections">
  <section class="section services-home">
    <div class="wrap">
      <div class="section-heading">
        <div>
          <h2>
            Our private
            <br />
            nursing services.
          </h2>
        </div>
        <a class="text-link" href={links.services}>
          Explore all services <Arrow />
        </a>
      </div>
      <div class="retainer-card-grid">
        {retainerServices.map((service) => (
          <a class="retainer-card" href={service.path}>
            <ServiceIcon slug={service.slug} />
            <h3>{service.title}</h3>
            <p>{service.summary}</p>
            <span class="service-card-action">Learn more <Arrow /></span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="section approach-section" id="approach">
    <div class="wrap">
      <div class="section-heading">
        <div>
          <h2>
            Our approach starts
            <br />
            with listening.
          </h2>
        </div>
        <a class="text-link" href="/approach">
          Explore our approach <Arrow />
        </a>
      </div>
      <div class="approach-steps">
        {approach.map((step, i) => (
          <div class="approach-step">
            <CounselImage
              class="approach-step-image"
              sizes="(max-width: 760px) calc(100vw - 48px), (max-width: 1100px) 45vw, 276px"
              src={`/images/counsel/${step.image}.webp`}
              alt={step.imageAlt}
              loading="lazy"
            />
            <div class="approach-step-copy">
              <span class="step-number" aria-hidden="true">0{i + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
  <section class="founder-section">
    <div class="wrap founder-grid">
      <div class="founder-image">
        <CounselImage
          src="/images/counsel/founder.webp"
          sizes="(max-width: 760px) calc(100vw - 48px), 600px"
          alt="Augustus Osgood, BSN, RN, founder of Counsel Concierge Nursing"
          loading="lazy"
        />
        <div class="founder-image-label">
          <span>Augustus Osgood</span>
          <span>BSN, RN · FOUNDER</span>
        </div>
      </div>
      <div class="founder-copy">
        <h2>
          “I founded Counsel
          <br />
          <em>to bridge the gap.”</em>
        </h2>
        <p>
          My name is Gus, and I am the founder of Counsel Concierge Nursing.
        </p>
        <p>
          I have spent the majority of my nursing career in critical care,
          emergency, and surgical settings, caring for patients with complex and
          evolving medical needs.
        </p>
        <p>
          Our standard is a comprehensive understanding of each client’s entire
          clinical picture from complex diagnoses to simple wellness habits.
        </p>
        <a class="text-link" href={links.about}>
          Meet Gus & explore our story <Arrow />
        </a>
      </div>
    </div>
  </section>
  </div>
  <section class="section insights-home">
    <div class="wrap">
      <div class="section-heading">
        <div>
          <h2>
            A little clarity.
            <br />
            <em>A more confident tomorrow.</em>
          </h2>
        </div>
        <a class="text-link" href="/insights">
          Read all insights <Arrow />
        </a>
      </div>
      <InsightCards limit={3} />
    </div>
  </section>
</Counsel>
