---
import "../styles/counsel.css";
import "../styles/counsel-system.css";
import Brand from "../components/counsel/Brand.astro";
import Arrow from "../components/counsel/Arrow.astro";
import ContactBand from "../components/counsel/ContactBand.astro";
import ConsultationDialog from "../components/counsel/ConsultationDialog.astro";
import ServicesNav from "../components/counsel/ServicesNav.astro";
import Analytics from "../components/Analytics.astro";
import { articles, links, postOpService, servicePages } from "../lib/counsel";
import { SITE, SITE_NAME, absolute, shareImage, structuredData } from "../lib/seo";
const {
  title = "Private Concierge Nursing in Nashville, TN",
  description = "Counsel Concierge Nursing provides private nursing oversight, care coordination, and advocacy for independent adults and their families in Nashville and Middle Tennessee.",
  noindex = false,
  editorial = false,
} = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
// Titles that already name the practice are not suffixed with it again.
const fullTitle = title.includes(SITE_NAME) ? title : `${title} | ${SITE_NAME}`;
const image = absolute(shareImage(path));
const article = articles.find((a) => a.path === path);
const schema = structuredData({ path: path === "/home" ? "/" : path, title: fullTitle, description, image });
// Optional HTML-tag verification for Google Search Console and Bing Webmaster
// Tools. DNS verification needs no code; see README.md.
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bingVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;
const nav = [
  ["About", links.about],
  ["Services", links.services],
  ["Our Approach", "/approach"],
  ["Insights", "/insights"],
];
const footerServices = [postOpService, ...servicePages];
const canonical = new URL(
  // Match the sitemap and the original Squarespace URLs, which have no trailing slash.
  path === "/home" ? "/" : path,
  SITE,
);
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <Analytics />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a2139" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
    />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="Counsel Concierge Nursing Insights" href="/insights/rss.xml" />
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    {bingVerification && <meta name="msvalidate.01" content={bingVerification} />}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE_NAME}, private nursing oversight in Nashville, TN`} />
    {article && <meta property="article:published_time" content={article.date} />}
    {article && <meta property="article:author" content={absolute(links.about)} />}
    {article && <meta property="article:section" content={article.category} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, "\\u003c")} />}
    <link
      rel="preload"
      href="/fonts/eb-garamond.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/montserrat.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class:list={["site-header header-overlay", { "header-editorial": editorial }]}>
      <div class="wrap header-inner">
        <Brand />
        <nav class="desktop-nav" aria-label="Main navigation">
          {nav.map(([label, url]) => (
            url === links.services ? <ServicesNav /> :
            <a href={url} aria-current={path === url ? "page" : undefined}>
              {label}
            </a>
          ))}
        </nav>
        <div class="header-actions">
          <a
            class="portal-link"
            href={links.portal}
            target="_blank"
            rel="noopener noreferrer"
          >
            Client Portal <Arrow diagonal />
          </a>
          <a class="button button-small" href={links.consultation}>
            Request Private Consultation
          </a>
        </div>
        <button
          class="menu-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-nav"
        >
          <span>Menu</span>
          <span class="menu-lines" aria-hidden="true"></span>
        </button>
      </div>
      <nav
        id="mobile-nav"
        class="mobile-nav"
        aria-label="Mobile navigation"
        hidden
      >
        {nav.map(([label, url]) => (
          url === links.services ? <ServicesNav /> :
          <a href={url} aria-current={path === url ? "page" : undefined}>
            {label}
            <Arrow />
          </a>
        ))}
        <a href={links.contact}>
          Contact <Arrow />
        </a>
        <a href={links.portal} target="_blank" rel="noopener noreferrer">
          Client Portal <Arrow diagonal />
        </a>
        <a href={links.consultation}>
          Request Private Consultation <Arrow />
        </a>
      </nav>
    </header>
    <main id="main">
      <slot />
      <ContactBand />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-main">
          <div class="footer-card">
            <Brand stacked />
            <h2>We’re here to listen.</h2>
            <div class="footer-reach">
              <a class="footer-phone" href="tel:+16159339208">
                <span class="footer-reach-full">(615) 933-9208</span>
                <span class="footer-reach-short">Call (615) 933-9208</span>
              </a>
              <a class="footer-email" href="mailto:info@counselconciergenursing.com">
                <span class="footer-reach-full">info@counselconciergenursing.com</span>
                <span class="footer-reach-short">Email us</span>
              </a>
            </div>
            <p>Serving Nashville and the surrounding Middle Tennessee area.</p>
            <div class="social-links">
              <a
                href="https://www.instagram.com/counselconciergenursing"
                target="_blank"
                rel="noopener noreferrer"
              >
                Instagram ↗
              </a>
              <a
                href="https://www.facebook.com/share/1CtNJRkpGv/?mibextid=wwXIfr"
                target="_blank"
                rel="noopener noreferrer"
              >
                Facebook ↗
              </a>
              <a
                href="https://linkedin.com/in/augustusosgood"
                target="_blank"
                rel="noopener noreferrer"
              >
                LinkedIn ↗
              </a>
            </div>
          </div>
          <!-- Link groups are open by default (and without JavaScript); on phones the
               script below collapses them into an accordion. -->
          <nav class="footer-links" aria-label="Footer">
            <details class="footer-group" open>
              <summary><h2>Services</h2></summary>
              <ul>
                {footerServices.map((service) => (
                  <li><a href={service.path}>{service.title}</a></li>
                ))}
              </ul>
            </details>
            <div>
              <details class="footer-group" open>
                <summary><h2>Explore</h2></summary>
                <ul>
                  {nav.map(([label, url]) => (
                    <li><a href={url}>{label}</a></li>
                  ))}
                </ul>
              </details>
              <details class="footer-group" open>
                <summary><h2>Connect</h2></summary>
                <ul>
                  <li><a href={links.consultation}>Request Private Consultation</a></li>
                  <li>
                    <a href={links.portal} target="_blank" rel="noopener noreferrer">
                      Client Portal ↗
                    </a>
                  </li>
                  <li><a href="/work-with-us">Work With Us</a></li>
                </ul>
              </details>
            </div>
          </nav>
        </div>
        <div class="footer-legal">
          <p class="footer-disclaimer">
            Counsel Concierge Nursing provides private, non-insurance-based
            nursing oversight and does not replace the role of a primary care
            provider or emergency services.
          </p>
          <div class="footer-bottom">
            <span>
              © 2026 Counsel Concierge Nursing, LLC. All rights reserved.
            </span>
            <div>
              <a href="/privacy-policy">Privacy Policy</a>
              <a href="/terms-of-use">Terms of Use</a>
              <a href="https://devotioncreative.com/" target="_blank" rel="noopener noreferrer">
                Built by Devotion Creative
              </a>
              <a href="#main">Back to top ↑</a>
            </div>
          </div>
        </div>
      </div>
    </footer>
    <ConsultationDialog />
    <script>
      const header = document.querySelector<HTMLElement>(".site-header");
      const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
      const menu = document.querySelector<HTMLElement>("#mobile-nav");
      const pageContent = document.querySelectorAll<HTMLElement>("main, .site-footer");
      function updateHeader() {
        header?.classList.toggle("is-scrolled", window.scrollY > 24);
      }
      updateHeader();
      window.addEventListener("scroll", updateHeader, { passive: true });
      window.addEventListener("pageshow", updateHeader);
      // Reveal hero links when keyboard navigation returns behind the content panel.
      document.querySelector(".interior-hero")?.addEventListener("focusin", () => {
        if (window.scrollY > 0) window.scrollTo({ top: 0, behavior: "instant" });
      });
      function closeMenu() {
        if (toggle && menu) {
          toggle.setAttribute("aria-expanded", "false");
          menu.hidden = true;
          header?.classList.remove("is-menu-open");
          document.documentElement.classList.remove("menu-open");
          pageContent.forEach((element) => { element.inert = false; });
          toggle.querySelector("span")!.textContent = "Menu";
        }
      }
      document.addEventListener("counsel:open-consultation", closeMenu);
      toggle?.addEventListener("click", () => {
        if (!menu) return;
        const open = toggle.getAttribute("aria-expanded") === "true";
        if (open) {
          closeMenu();
          return;
        }
        toggle.setAttribute("aria-expanded", "true");
        toggle.querySelector("span")!.textContent = "Close";
        menu.hidden = false;
        header?.classList.add("is-menu-open");
        document.documentElement.classList.add("menu-open");
        pageContent.forEach((element) => { element.inert = true; });
      });
      menu?.addEventListener("click", (event) => {
        if ((event.target as Element).closest("a")) closeMenu();
      });
      document.addEventListener("click", (event) => {
        if (!header?.contains(event.target as Node)) closeMenu();
      });
      window.addEventListener("pageshow", closeMenu);
      document.addEventListener("keydown", (e) => {
        if (e.key === "Tab" && toggle?.getAttribute("aria-expanded") === "true") {
          const first = header?.querySelector<HTMLAnchorElement>(".brand");
          const last = menu?.querySelector<HTMLAnchorElement>(":scope > a:last-child");
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last?.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first?.focus();
          }
        }
        if (
          e.key === "Escape" &&
          toggle?.getAttribute("aria-expanded") === "true"
        ) {
          closeMenu();
          toggle.focus();
        }
      });
      window
        .matchMedia("(min-width: 1101px)")
        .addEventListener("change", (e) => {
          if (e.matches) closeMenu();
        });
      // Footer link groups: an accordion on phones, always-open columns on larger screens.
      const footerPhone = window.matchMedia("(max-width: 760px)");
      const footerGroups = document.querySelectorAll<HTMLDetailsElement>(".footer-group");
      function syncFooterGroups() {
        footerGroups.forEach((group) => {
          group.open = !footerPhone.matches;
          // Fixed columns on larger screens: keep their headings out of the tab order.
          group.querySelector("summary")!.tabIndex = footerPhone.matches ? 0 : -1;
        });
      }
      syncFooterGroups();
      footerPhone.addEventListener("change", syncFooterGroups);
      footerGroups.forEach((group) => {
        group.querySelector("summary")!.addEventListener("click", (event) => {
          if (!footerPhone.matches) event.preventDefault();
        });
      });
    </script>
  </body>
</html>
